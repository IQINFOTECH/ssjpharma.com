# =============================================================================
#  SSJ Pharmaceuticals LLP — Environment configuration TEMPLATE
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values on each environment.
#  NEVER commit the real `.env`. Keep it outside the webroot / deny via .htaccess.
#  File permissions on the server should be 600.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="SSJ Pharmaceuticals"
APP_ENV=production            # local | production
APP_DEBUG=false               # true ONLY on local; MUST be false in production
APP_URL=https://ssjpharma.com
APP_TIMEZONE=Asia/Kolkata

# 32+ random bytes, base64. Generate with:  php bin/keygen.php
APP_KEY=

# --- Database (MySQL / MariaDB) ---------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Mail (SMTP) -------------------------------------------------------------
# Provider-agnostic. Real credentials are supplied at deployment time.
# Works with any standard SMTP account on the SSJ Pharmaceuticals domain.
MAIL_MAILER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=          # tls | ssl  (587=tls, 465=ssl)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SSJ Pharmaceuticals"

# Delivery mode: smtp | log | disabled. Blank = auto (smtp when configured, else
# log). Use "log" or "disabled" in dev/staging so no real emails are ever sent.
MAIL_DELIVERY_MODE=

# Internal lead / contact notification recipient. The app resolves the recipient
# as: CMS setting lead_notification_email → lead_sales_email → this value.
# (Equivalent to LEAD_NOTIFICATION_EMAIL — set it in the CMS or here.)
MAIL_SALES_INBOX=

# --- WhatsApp (Click-to-Chat only at launch; see ADR-005) -------------------
# International format, digits only (e.g. 919876543210). CMS can override.
WHATSAPP_NUMBER=
WHATSAPP_DEFAULT_MESSAGE="Hello SSJ Pharmaceuticals, I would like to know more about your products."

# --- Analytics ---------------------------------------------------------------
# Analytics is CMS-managed (Admin → Settings → Analytics), NOT via .env:
#   - Google Analytics 4 ID (G-XXXX)         -> setting analytics_ga_id
#   - Google Search Console verification     -> setting analytics_gsc_verification
#   - Bing Webmaster verification            -> setting analytics_bing_verification
# GA4 loads only when an ID is configured. No analytics credentials are secrets.

# --- Anti-spam (Cloudflare Turnstile) ----------------------------------------
# Enable + site key are set in the CMS (Settings → Security). The SECRET stays here.
TURNSTILE_SECRET=

# --- Security ----------------------------------------------------------------
SESSION_NAME=ssjp_session
SESSION_LIFETIME=120          # minutes (idle)
SESSION_SECURE=true           # true in production (HTTPS). false only on local http.
