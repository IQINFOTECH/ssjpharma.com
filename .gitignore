# Environment & secrets — NEVER commit
.env
.env.*
!.env.example

# Storage (runtime) — keep the folders, ignore the contents
/storage/logs/*
/storage/cache/*
/storage/sessions/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/sessions/.gitkeep

# Uploads (user/CMS media)
/public/uploads/*
!/public/uploads/.gitkeep

# Backups — never in the webroot or the repo
/backups/
*.sql.gz
*.dump

# Dependencies
# NOTE: per ADR-001, the production vendor/ IS committed for cPanel/no-SSH deploy.
# Dev-only tooling is stripped before commit via: composer install --no-dev -o
/node_modules/

# Build tool (Tailwind) local caches
/.parcel-cache/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp

# PHPUnit
/.phpunit.result.cache
/tests/coverage/

# PHPUnit cache dir
/.phpunit.cache/
