{
    "name": "ssjpharma/website",
    "description": "SSJ Pharmaceuticals LLP — corporate website, product catalog, CMS and built-in Lead CRM. Custom lightweight PHP 8.3 MVC for standard cPanel/Apache/MySQL hosting.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-gd": "Image resizing for the CMS media library (Phase 3).",
        "ext-intl": "Locale-aware formatting."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
